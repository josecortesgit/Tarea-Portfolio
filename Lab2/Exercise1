# Introducir datos
num_segundos = int(input("Seconds: "))

segundos_dia = 24 * 60 * 60

dias = num_segundos // segundos_dia
resto = num_segundos % segundos_dia

horas = resto // 3600
resto = resto % 3600

minutos = resto // 60
segundos = resto % 60

# Salida
print(f"{num_segundos} seconds are {dias} days, {horas} hours, {minutos} minutes and {segundos} seconds")
